# Supplied explicitly to live commands; Python does not automatically load .env.
# Never commit real values. Offline commands and tests need no provider keys.
RUMIK_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
BENCH_TOOLS_SECRET=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Optional digest credentials for the configured destination SIP host. Supply both.
PLIVO_SIP_AUTH_USERNAME=
PLIVO_SIP_AUTH_PASSWORD=

# Development database only. Start the optional Compose database profile first.
DATABASE_URL=postgresql://voice_bench:local_only@127.0.0.1:5432/voice_bench
# Use a dedicated test database; tests create and drop their own schemas.
TEST_DATABASE_URL=

# S3 credentials come from the normal AWS credential chain. Bucket/region are TOML settings.
AWS_REGION=ap-south-1
